# Backend origin. Must be the LAN IP, not localhost: on a physical device
# `localhost` resolves to the phone itself, so every request is refused.
EXPO_PUBLIC_API_URL=

# Comma-separated ICE server URLs. TURN is only enabled when URLs,
# username, and credential are all set. Credentials stay in the gitignored .env.
EXPO_PUBLIC_STUN_URLS=
EXPO_PUBLIC_TURN_URLS=
EXPO_PUBLIC_TURN_USERNAME=
EXPO_PUBLIC_TURN_CREDENTIAL=
