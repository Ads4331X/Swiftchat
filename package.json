{
  "name": "swiftchat",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:lan": "LAN_IP=$(ip -4 route get 1.1.1.1 | awk '{for (i = 1; i <= NF; i++) if ($i == \"src\") {print $(i + 1); exit}}'); if [ -z \"$LAN_IP\" ]; then echo 'Could not determine the LAN IPv4 address from the default route.' >&2; exit 1; fi; REACT_NATIVE_PACKAGER_HOSTNAME=\"$LAN_IP\" expo start --lan",
    "start:tunnel": "expo start --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "reverse": "bash scripts/adb-reverse.sh",
    "lint": "expo lint",
    "postinstall": "patch-package"
  },
